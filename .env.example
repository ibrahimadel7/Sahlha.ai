# Primary LLM provider: Groq (OpenAI-compatible). Without a key the agent uses a grounded deterministic fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Backup LLM provider: OpenRouter (OpenAI-compatible). Auto-used ONLY when Groq fails (rate-limit/quota/5xx/timeout).
# Add this key to make Sahlha resilient — no code change needed. If omitted, Groq → deterministic fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Text-to-speech for explanations (Groq Orpheus English). You must also accept the model's
# terms once in the Groq console (playground), otherwise speech calls fail.
# GROQ_TTS_VOICE=troy
# Backup TTS via OpenRouter (OpenAI-compatible). Auto-used when Groq TTS fails. Requires OPENROUTER_API_KEY.
# Supported via POST /api/v1/audio/speech (mp3/pcm) e.g. fish-audio/s2.1-pro-free:free (free) or openai/gpt-4o-mini-tts-2025-12-15 (alloy). See https://openrouter.ai/docs/guides/overview/multimodal/tts.mdx
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
OPENROUTER_TTS_VOICE=alloy
# Skill images via Pexels (get a free key at https://www.pexels.com/api/).
# Without it the image tool returns 503 and skills simply show no picture.
PEXELS_API_KEY=
# OCR engine overrides (auto-detected otherwise: PATH, then default install paths).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\...\poppler\bin
DATABASE_URL=sqlite:///./data/sahlha.db
# Optional teacher gate (P0-5): when set, teacher POSTs (upload/extract/generate/
# approve/reject/flag) require header X-API-Key. Empty = open (dev/test default).
# TEACHER_API_KEY=
