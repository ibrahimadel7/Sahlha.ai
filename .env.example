# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL=sqlite:///./data/sahlha.db

# --- Auth (JWT). Use a long random value outside local dev. ---
JWT_SECRET=sahlha-dev-secret-change-me-in-production-32
JWT_EXPIRES_MINUTES=10080

# --- Mastery thresholds (student-facing states) ---
MASTERY_DEVELOPING_MIN=0.6
MASTERY_MASTERED_MIN=0.8
MASTERY_MIN_ATTEMPTS=4

# --- Uploads ---
MAX_UPLOAD_MB=25

# --- CORS: extra allowed origins, comma-separated (mobile dev) ---
CORS_EXTRA_ORIGINS=

# Primary LLM provider: Groq (OpenAI-compatible). Without a key the agent uses a grounded deterministic fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Backup LLM provider: OpenRouter (OpenAI-compatible). Auto-used ONLY when Groq fails (rate-limit/quota/5xx/timeout).
# Add this key to make Sahlha resilient — no code change needed. If omitted, Groq → deterministic fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PROVIDER_TIMEOUT_SECONDS=45
# Text-to-speech for explanations (Groq Orpheus English). You must also accept the model's
# terms once in the Groq console (playground), otherwise speech calls fail.
# GROQ_TTS_VOICE=troy
# Backup TTS via OpenRouter (OpenAI-compatible). Auto-used when Groq TTS fails. Requires OPENROUTER_API_KEY.
# Supported via POST /api/v1/audio/speech (mp3/pcm) e.g. fish-audio/s2.1-pro-free:free (free) or openai/gpt-4o-mini-tts-2025-12-15 (alloy). See https://openrouter.ai/docs/guides/overview/multimodal/tts.mdx
# --- Speech providers; existing mobile media contract remains WAV ---
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
GROQ_TTS_MAX_CHARS=900
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
OPENROUTER_TTS_VOICE=alloy
# PCM is wrapped as mono signed 16-bit WAV. Match rate to configured provider.
# MP3 requires system ffmpeg to convert to the same WAV contract.
OPENROUTER_TTS_FORMAT=pcm
OPENROUTER_TTS_SAMPLE_RATE=24000
# Skill images via Pexels (get a free key at https://www.pexels.com/api/).
# Without it the image tool returns 503 and skills simply show no picture.
PEXELS_API_KEY=
# OCR engine overrides (auto-detected otherwise: PATH, then default install paths).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\...\poppler\bin
# --- Optional OCR binaries; PATH takes precedence ---
TESSERACT_CMD=
POPPLER_PATH=
OCR_MIN_CHARS=50
# Installed Tesseract language packs; e.g. ara+eng for Arabic/English lessons.
OCR_LANGUAGES=eng
OCR_DPI=250
# Optional sentence-transformers CrossEncoder; failure preserves hybrid ranking.
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Needed to verify general semantic MCQs; without it, use verified source completions.
ENABLE_LLM_CRITIQUE=false

# --- Retrieval: dense is optional; failures use offline TF-IDF ---
DENSE_EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_WARMUP=true
VECTOR_CACHE_PATH=./data/vectors.npz
VECTOR_INCREMENTAL_CHURN=0.35
MMR_LAMBDA=0.7
DENSE_MIN_SCORE=0.05
RETRIEVAL_BACKOFF_RATIO=0.5
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Optional teacher gate (P0-5): when set, teacher POSTs (upload/extract/generate/
# approve/reject/flag) require header X-API-Key. Empty = open (dev/test default).
# TEACHER_API_KEY=

# Public old MVP development endpoints are enabled during transition so both
# Streamlit/tests (legacy) and mobile platform work. Set false only when legacy clients retired.
# Never enable on a shared or production backend without auth.
LEGACY_DEV_API_ENABLED=true
